<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop rescap">
  <Identity
    Name="MYuitsu.PrintUtil"
    Publisher="CN=REPLACE_WITH_CERTIFICATE_SUBJECT"
    Version="0.3.0.0"
    ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>print-utils</DisplayName>
    <PublisherDisplayName>REPLACE_WITH_PARTNER_CENTER_PUBLISHER_NAME</PublisherDisplayName>
    <Description>Silent local PDF printing utility</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application
      Id="PrintUtil"
      Executable="print-util-tray.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="print-utils"
        Description="Silent local PDF printing utility"
        BackgroundColor="#2563EB"
        Square44x44Logo="Assets\StoreLogo.png"
        Square150x150Logo="Assets\Square150x150Logo.png" />
      <Extensions>
        <uap5:Extension
          Category="windows.startupTask"
          Executable="print-util-tray.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask
            TaskId="PrintUtilTrayStartup"
            Enabled="true"
            DisplayName="print-utils" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>